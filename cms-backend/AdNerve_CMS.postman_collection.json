{
  "info": {
    "name": "AdNerve CMS Backend",
    "description": "Full API collection for the AdNerve CMS backend. Set `baseUrl` variable to your server (default: http://localhost:8080). Login first — the collection auto-saves the JWT and device JWT into collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8080" },
    { "key": "jwt",           "value": "" },
    { "key": "deviceJwt",     "value": "" },
    { "key": "screenId",      "value": "" },
    { "key": "categoryType",  "value": "MORNING", "description": "MORNING | AFTERNOON | EVENING" },
    { "key": "slotPosition",  "value": "1", "description": "1..defaultSlotCount" },
    { "key": "mediaId",       "value": "" },
    { "key": "uploadUrl",     "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.success && body.data) {",
                  "        pm.collectionVariables.set('jwt', body.data.accessToken);",
                  "        console.log('JWT saved to collection variable');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Login — wrong password (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },
        {
          "name": "Login — missing email (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"password\"\n}"
            }
          }
        },
        {
          "name": "Issue Device Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.success && body.data) {",
                  "        pm.collectionVariables.set('deviceJwt', body.data.accessToken);",
                  "        console.log('Device JWT saved to collection variable');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/auth/device/token", "host": ["{{baseUrl}}"], "path": ["v1", "auth", "device", "token"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"screenId\": \"{{screenId}}\",\n  \"expiresDays\": 365\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Screens",
      "item": [
        {
          "name": "List Screens",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/screens", "host": ["{{baseUrl}}"], "path": ["v1", "screens"] }
          }
        },
        {
          "name": "Create Screen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.success && body.data) {",
                  "        pm.collectionVariables.set('screenId', body.data.id);",
                  "        console.log('screenId saved:', body.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/screens", "host": ["{{baseUrl}}"], "path": ["v1", "screens"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lobby Screen\",\n  \"location\": \"Main Entrance\",\n  \"timezone\": \"Asia/Kolkata\",\n  \"defaultSlotLengthSeconds\": 10,\n  \"defaultSlotCount\": 6\n}"
            },
            "description": "Creates a screen. Auto-creates 3 categories (MORNING 09-12, AFTERNOON 12-17, EVENING 17-22). defaultSlotLengthSeconds and defaultSlotCount are optional (defaults: 10s, 6 slots)."
          }
        },
        {
          "name": "Get Screen",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/screens/{{screenId}}", "host": ["{{baseUrl}}"], "path": ["v1", "screens", "{{screenId}}"] }
          }
        },
        {
          "name": "Update Screen",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/screens/{{screenId}}", "host": ["{{baseUrl}}"], "path": ["v1", "screens", "{{screenId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lobby Screen (Updated)\",\n  \"location\": \"Main Entrance\",\n  \"timezone\": \"Asia/Kolkata\",\n  \"defaultSlotLengthSeconds\": 15,\n  \"defaultSlotCount\": 4\n}"
            }
          }
        },
        {
          "name": "Delete Screen",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/screens/{{screenId}}", "host": ["{{baseUrl}}"], "path": ["v1", "screens", "{{screenId}}"] }
          }
        },
        {
          "name": "List Screens — unauthenticated (403)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/v1/screens", "host": ["{{baseUrl}}"], "path": ["v1", "screens"] }
          }
        },
        {
          "name": "Get Screen — not found (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/screens/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["v1", "screens", "00000000-0000-0000-0000-000000000000"] }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "description": "Each screen has 3 fixed categories: MORNING, AFTERNOON, EVENING. They are auto-created when the screen is created with default time windows. You can update the time windows or toggle them active/inactive.",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories"]
            },
            "description": "Returns all 3 categories for the screen ordered by startTime."
          }
        },
        {
          "name": "Update Category Times — MORNING",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/MORNING",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "MORNING"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"08:00:00\",\n  \"endTime\": \"12:00:00\"\n}"
            },
            "description": "Update the time window for MORNING. Repeat with AFTERNOON or EVENING in the URL for other categories. startTime must be before endTime."
          }
        },
        {
          "name": "Update Category Times — AFTERNOON",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/AFTERNOON",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "AFTERNOON"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"12:00:00\",\n  \"endTime\": \"17:00:00\"\n}"
            }
          }
        },
        {
          "name": "Update Category Times — EVENING",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/EVENING",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "EVENING"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"17:00:00\",\n  \"endTime\": \"22:00:00\"\n}"
            }
          }
        },
        {
          "name": "Toggle Category Active — MORNING",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/MORNING/toggle",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "MORNING", "toggle"]
            },
            "description": "Toggles isActive on the category. Inactive categories are excluded from schedule pushes."
          }
        }
      ]
    },
    {
      "name": "Slot Assignments",
      "description": "Each category has slots numbered 1..defaultSlotCount. Each slot holds 0 or 1 video. The video's durationSeconds must match the screen's defaultSlotLengthSeconds.",
      "item": [
        {
          "name": "List Slots — MORNING",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/MORNING/slots",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "MORNING", "slots"]
            },
            "description": "Returns all slot positions (1..defaultSlotCount). Empty slots have mediaId/name/mediaType as null."
          }
        },
        {
          "name": "List Slots — AFTERNOON",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/AFTERNOON/slots",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "AFTERNOON", "slots"]
            }
          }
        },
        {
          "name": "List Slots — EVENING",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/EVENING/slots",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "EVENING", "slots"]
            }
          }
        },
        {
          "name": "Assign Media to Slot",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/{{categoryType}}/slots/{{slotPosition}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "{{categoryType}}", "slots", "{{slotPosition}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaId\": \"{{mediaId}}\"\n}"
            },
            "description": "Assigns a media to a slot position. Validates:\n- Media must be active (confirmed)\n- Media must be video (not image)\n- Media durationSeconds must match screen.defaultSlotLengthSeconds\n- Position must be between 1 and defaultSlotCount\n\nIf the slot is already occupied, the existing assignment is replaced."
          }
        },
        {
          "name": "Assign Media to Slot — MORNING slot 1",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/MORNING/slots/1",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "MORNING", "slots", "1"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaId\": \"{{mediaId}}\"\n}"
            }
          }
        },
        {
          "name": "Assign Media to Slot — MORNING slot 2",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/MORNING/slots/2",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "MORNING", "slots", "2"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaId\": \"{{mediaId}}\"\n}"
            }
          }
        },
        {
          "name": "Clear Slot",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/{{categoryType}}/slots/{{slotPosition}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "{{categoryType}}", "slots", "{{slotPosition}}"]
            },
            "description": "Removes the media assignment from a slot. The slot becomes empty."
          }
        },
        {
          "name": "Assign — invalid position (400)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/screens/{{screenId}}/categories/MORNING/slots/99",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "screens", "{{screenId}}", "categories", "MORNING", "slots", "99"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaId\": \"{{mediaId}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "List Media",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/media", "host": ["{{baseUrl}}"], "path": ["v1", "media"] },
            "description": "Returns only active (confirmed) media records. Pending records are hidden."
          }
        },
        {
          "name": "Create Media",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.success && body.data) {",
                  "        pm.collectionVariables.set('mediaId', body.data.id);",
                  "        pm.collectionVariables.set('uploadUrl', body.data.uploadUrl);",
                  "        console.log('mediaId saved:', body.data.id);",
                  "        console.log('uploadUrl saved — PUT your file to this URL');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/media", "host": ["{{baseUrl}}"], "path": ["v1", "media"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Promo Video Q1\",\n  \"filename\": \"promo-q1.mp4\",\n  \"mimeType\": \"video/mp4\",\n  \"fileSizeBytes\": 10485760,\n  \"durationSeconds\": 10\n}"
            },
            "description": "Step 1 of 2. Creates a pending DB record and returns a presigned S3 PUT URL (valid 15 min). durationSeconds must match the screen's defaultSlotLengthSeconds (default 10s) to be assignable.\n\nAfter this call:\n1. PUT your file directly to the uploadUrl with Content-Type matching mimeType\n2. Call 'Confirm Media' to mark the record active"
          }
        },
        {
          "name": "Upload File to S3 (PUT to uploadUrl)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "video/mp4" }
            ],
            "url": { "raw": "{{uploadUrl}}", "host": ["{{uploadUrl}}"] },
            "body": {
              "mode": "file",
              "file": {}
            },
            "description": "Direct S3 upload — no backend involved. Select your file in the Body tab (binary). The Content-Type header must match the mimeType from Create Media."
          }
        },
        {
          "name": "Confirm Media",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/media/{{mediaId}}/confirm", "host": ["{{baseUrl}}"], "path": ["v1", "media", "{{mediaId}}", "confirm"] },
            "description": "Step 2 of 2. Marks the record active so it can be assigned to slots and included in schedule pushes."
          }
        },
        {
          "name": "Get Media",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/media/{{mediaId}}", "host": ["{{baseUrl}}"], "path": ["v1", "media", "{{mediaId}}"] }
          }
        },
        {
          "name": "Delete Media",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/media/{{mediaId}}", "host": ["{{baseUrl}}"], "path": ["v1", "media", "{{mediaId}}"] }
          }
        }
      ]
    },
    {
      "name": "Push",
      "item": [
        {
          "name": "Push Schedule to Screen",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/screens/{{screenId}}/push", "host": ["{{baseUrl}}"], "path": ["v1", "screens", "{{screenId}}", "push"] },
            "description": "Builds the full schedule and pushes it to the screen via SSE. Returns the schedule payload.\n\nResponse shape:\n{\n  screenId, timezone, defaultSlotLengthSeconds, generatedAt,\n  categories: [\n    {\n      category: \"MORNING\",\n      startTime: \"09:00\", endTime: \"12:00\", isActive: true,\n      slots: [\n        { position: 1, mediaId, name, mediaType, url },\n        { position: 2, mediaId: null, name: null, mediaType: null, url: null }\n      ]\n    }, ...\n  ]\n}"
          }
        }
      ]
    },
    {
      "name": "Device",
      "item": [
        {
          "name": "Heartbeat",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{deviceJwt}}" }],
            "url": { "raw": "{{baseUrl}}/v1/device/heartbeat", "host": ["{{baseUrl}}"], "path": ["v1", "device", "heartbeat"] },
            "description": "Updates lastSeenAt on the screen. Get deviceJwt from 'Issue Device Token' first."
          }
        },
        {
          "name": "Log Impressions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{deviceJwt}}" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/device/impressions", "host": ["{{baseUrl}}"], "path": ["v1", "device", "impressions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"impressions\": [\n    {\n      \"mediaId\": \"{{mediaId}}\",\n      \"category\": \"MORNING\",\n      \"slotPosition\": 1,\n      \"playedAt\": \"2026-05-14T10:00:00Z\",\n      \"durationPlayedSeconds\": 10,\n      \"completed\": true\n    }\n  ]\n}"
            },
            "description": "Batch upload up to 500 impression records. category and slotPosition are optional but recommended for analytics."
          }
        },
        {
          "name": "SSE Stream (subscribe)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{deviceJwt}}" },
              { "key": "Accept", "value": "text/event-stream" }
            ],
            "url": { "raw": "{{baseUrl}}/v1/device/stream", "host": ["{{baseUrl}}"], "path": ["v1", "device", "stream"] },
            "description": "Opens a Server-Sent Events stream. The device listens here for schedule updates pushed by admin."
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Query Impressions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/analytics/impressions?screenId={{screenId}}&from=2026-05-01&to=2026-05-31",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "analytics", "impressions"],
              "query": [
                { "key": "screenId", "value": "{{screenId}}" },
                { "key": "mediaId",  "value": "", "disabled": true },
                { "key": "from",     "value": "2026-05-01" },
                { "key": "to",       "value": "2026-05-31" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health & Docs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
          }
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/swagger-ui/index.html", "host": ["{{baseUrl}}"], "path": ["swagger-ui", "index.html"] }
          }
        },
        {
          "name": "OpenAPI Spec (JSON)",
          "request": {
            "method": "GET",
            "header": [],
