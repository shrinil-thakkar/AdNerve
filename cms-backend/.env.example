# Copy this file to .env and fill in real values

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/cms_db
DATABASE_USERNAME=cms_user
DATABASE_PASSWORD=secret

# JWT — must be at least 32 characters
JWT_SECRET=change-this-to-a-long-random-secret-key-minimum-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEVICE_TOKEN_EXPIRE_DAYS=365

# AWS
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-cms-bucket

# Presigned URL expiry
PRESIGNED_UPLOAD_EXPIRE_SECONDS=900
PRESIGNED_DOWNLOAD_EXPIRE_SECONDS=86400

# Media limits
MAX_UPLOAD_SIZE_MB=500

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Analytics
IMPRESSION_BATCH_SIZE=500
